# Copy this file to ".env" and fill in your values.
# NEVER commit the actual .env file — it holds secrets.

# ===== Hardhat deploy =====
# Private key of the Ganache account that will deploy and become
# contract admin + default arbiter. Get it from the Ganache GUI
# (click the key icon next to any account and copy the private key).
# Leave blank to let Hardhat use whatever Ganache picks as the default account.
DEPLOYER_PRIVATE_KEY=0x_paste_your_deployer_private_key_here
