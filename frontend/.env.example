# Copy this file to "frontend/.env" and fill in your values.
# NEVER commit the actual .env file — it holds secrets.
#
# Both keys are OPTIONAL. If you leave them blank the DApp runs in
# local demo IPFS mode (files kept in browser localStorage only).
#
# How to get them (free, ~2 minutes):
#   1. Sign up at https://pinata.cloud
#   2. Dashboard -> API Keys -> New Key -> toggle "Admin" on -> Create
#   3. Copy the two values below.
#   4. Restart `npm start` so React picks them up.

REACT_APP_PINATA_API_KEY=paste_your_pinata_api_key_here
REACT_APP_PINATA_SECRET_KEY=paste_your_pinata_api_secret_here
